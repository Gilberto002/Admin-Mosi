Options -Indexes

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|php[0-9]?|phtml|phar|cgi|pl|py|sh|asp|aspx|jsp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=vending
DB_USER=usuario
DB_PASS=contrasena

DB_INSTANCE=
DB_TRUST_SERVER_CERTIFICATE=true

APP_ENV=development
APP_TIMEZONE=America/Mexico_City

ANDROID_API_TOKEN=cambia-este-token
ANDROID_JSON_MAX_BYTES=1048576

# Token para que cada MOSI reporte su latido de conectividad.
MOSI_API_TOKEN=cambia-este-token-mosi
MOSI_JSON_MAX_BYTES=262144

# Base del tablero anterior de medicos. Si se deja vacio se usa la DB principal.
TELEMEDICINA_DB_HOST=
TELEMEDICINA_DB_PORT=1433
TELEMEDICINA_DB_NAME=
TELEMEDICINA_DB_USER=
TELEMEDICINA_DB_PASS=
TELEMEDICINA_DB_INSTANCE=
TELEMEDICINA_DB_TRUST_SERVER_CERTIFICATE=true

# Integracion servidor a servidor con Medical Center (PHP 5.2).
# Use un secreto largo y distinto al token de Android.
MEDICAL_CENTER_INTEGRATION_TOKEN=cambia-este-token-medical-center
# Activa el modulo web de carrito.
FEATURE_CARRITO_COMPRAS=false

# Google Routes API. Dejar vacio desactiva Google y usa calculo local.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=

# Sugerencia aproximada de ubicación durante activación Android.
# {ip} se reemplaza por la IP pública validada. Para dirección completa se usa GOOGLE_MAPS_API_KEY.
IP_GEOLOCATION_ENDPOINT=https://ipwho.is/{ip}

# Punto de salida para rutas de distribucion.
DISTRIBUCION_ORIGEN_NOMBRE=
DISTRIBUCION_ORIGEN_DIRECCION=
DISTRIBUCION_ORIGEN_LAT=
DISTRIBUCION_ORIGEN_LNG=
DISTRIBUCION_GASOLINA_PRECIO_LITRO_MXN=
DISTRIBUCION_RENDIMIENTO_KM_L=10

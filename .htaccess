# Bloquea el acceso web a TODO lo que esté fuera de /public.
# Si tu Document Root del VPS ya apunta directo a /public, este
# archivo es una segunda capa de seguridad y no estorba.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
